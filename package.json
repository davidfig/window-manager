{
  "name": "simple-window-manager",
  "version": "2.1.3",
  "description": "A vanilla javascript Window Manager with optional application-level menu and keyboard accelerators",
  "main": "public/simple-window-manager.min.js",
  "module": "src/index.js",
  "scripts": {
    "start": "rollup --bundleConfigAsCjs --watch -c docs/rollup.debug.js",
    "docs": "jsdoc -c .jsdoc.json",
    "build-images": "node images/import",
    "build-demo": "rollup --bundleConfigAsCjs -c docs/rollup.config.js",
    "build": "rollup --bundleConfigAsCjs -c rollup.config.js",
    "prepublishOnly": "yarn build-demo && yarn docs && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidfig/window-manager.git"
  },
  "bugs": {
    "url": "https://github.com/davidfig/window-manager/issues"
  },
  "homepage": "https://github.com/davidfig/window-manager#readme",
  "author": "David Figatner (david@yopeyopey.com)",
  "license": "MIT",
  "dependencies": {
    "clicked": "^3.2.3",
    "eventemitter3": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29",
    "@rollup/plugin-node-resolve": "^16",
    "@rollup/plugin-terser": "^1",
    "fs-extra": "^11",
    "jsdoc": "^4",
    "rollup": "^4",
    "rollup-plugin-livereload": "^2",
    "rollup-plugin-serve": "^3",
    "yy-fps": "^2",
    "yy-jsdoc-template": "^1.3"
  }
}
